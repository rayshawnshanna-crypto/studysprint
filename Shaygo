<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>StudySprint</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f3f6fc;color:#172554}
header{background:#2448d8;color:white;padding:24px 18px}
header h1{margin:0 0 8px}
main{max-width:700px;margin:auto;padding:18px}
.card{background:white;padding:18px;border-radius:16px;margin-bottom:16px;box-shadow:0 3px 12px #17255410}
input,select,button{font:inherit;padding:12px;border-radius:9px}
input,select{width:100%;border:1px solid #cbd5e1;margin:6px 0 12px;background:white}
button{border:0;background:#2448d8;color:white;cursor:pointer}
form button{width:100%}
.task{display:flex;align-items:center;gap:10px;padding:12px 0;border-bottom:1px solid #e2e8f0}
.task input{width:auto;margin:0}
.task span{flex:1;overflow-wrap:anywhere}
.task small{display:block;color:#64748b;margin-top:5px}
.task.done span{text-decoration:line-through;color:#64748b}
.delete{background:#fee2e2;color:#991b1b;padding:8px}
.stats{display:flex;gap:10px}
.stats div{flex:1;background:#e8edff;padding:12px;border-radius:10px;text-align:center}
.stats strong{display:block;font-size:24px;margin-top:5px}
label{font-size:14px;font-weight:bold}
footer{text-align:center;color:#64748b;padding:20px;font-size:13px}
</style>
</head>
<body>
<header>
  <h1>📚 StudySprint</h1>
  <div>Your goals. Your progress. Your future.</div>
</header>
<main>
  <section class="card">
    <h2>My study dashboard</h2>
    <p id="today"></p>
    <div class="stats">
      <div>Tasks left<strong id="remaining">0</strong></div>
      <div>Completed<strong id="completed">0</strong></div>
    </div>
  </section>

  <section class="card">
    <h2>Add a study task</h2>
    <form id="taskForm">
      <label for="task">Homework or test</label>
      <input id="task" placeholder="e.g. Revise algebra" required maxlength="120">
      <label for="subject">Subject</label>
      <select id="subject">
        <option>Mathematics</option>
        <option>English</option>
        <option>Life Sciences</option>
        <option>Physical Sciences</option>
        <option>Accounting</option>
        <option>History</option>
        <option>Geography</option>
        <option>Other</option>
      </select>
      <label for="due">Due date</label>
      <input id="due" type="date" required>
      <button type="submit">+ Add task</button>
    </form>
  </section>

  <section class="card">
    <h2>My tasks</h2>
    <div id="taskList"></div>
    <p id="empty">No tasks yet. Add your first task above!</p>
  </section>
  <footer>StudySprint • One task at a time.</footer>
</main>
<script>
const $ = id => document.getElementById(id);
let tasks = [];
try {
  tasks = JSON.parse(localStorage.getItem("studysprint-tasks") || "[]");
  if (!Array.isArray(tasks)) tasks = [];
} catch { tasks = []; }

const now = new Date();
$("today").textContent = now.toLocaleDateString("en-ZA", {
  weekday:"long", day:"numeric", month:"long", year:"numeric"
});
$("due").value = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,"0")}-${String(now.getDate()).padStart(2,"0")}`;

function save() {
  localStorage.setItem("studysprint-tasks", JSON.stringify(tasks));
  render();
}
function render() {
  const list = $("taskList");
  list.replaceChildren();
  $("empty").hidden = tasks.length > 0;
  $("remaining").textContent = tasks.filter(t => !t.done).length;
  $("completed").textContent = tasks.filter(t => t.done).length;

  tasks.slice().sort((a,b) => a.due.localeCompare(b.due)).forEach(t => {
    const row = document.createElement("div");
    row.className = "task" + (t.done ? " done" : "");
    const check = document.createElement("input");
    check.type = "checkbox";
    check.checked = t.done;
    check.setAttribute("aria-label", "Mark task complete");
    check.addEventListener("change", () => {
      t.done = check.checked;
      save();
    });
    const info = document.createElement("span");
    info.textContent = t.name;
    const small = document.createElement("small");
    small.textContent = `${t.subject} • Due ${t.due}`;
    info.appendChild(small);
    const del = document.createElement("button");
    del.className = "delete";
    del.textContent = "Delete";
    del.addEventListener("click", () => {
      tasks = tasks.filter(x => x.id !== t.id);
      save();
    });
    row.append(check, info, del);
    list.appendChild(row);
  });
}
$("taskForm").addEventListener("submit", e => {
  e.preventDefault();
  tasks.push({
    id: Date.now() + Math.random(),
    name: $("task").value.trim(),
    subject: $("subject").value,
    due: $("due").value,
    done: false
  });
  save();
  $("task").value = "";
});
render();
</script>
</body>
</html>
